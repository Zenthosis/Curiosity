[gd_resource type="ShaderMaterial" format=3 uid="uid://crli075ohjbum"]

[sub_resource type="Shader" id="Shader_byyf6"]
code = "shader_type canvas_item;
uniform vec2 object_pos;
uniform vec2 light_pos;

void vertex() {
}

void fragment() {
}

void light() {
	// vec2 torch_pos = LIGHT_VERTEX.xy; // xy of the emitter of the light
	if (light_pos.y <= object_pos.y){
		LIGHT = vec4(COLOR.rgb * LIGHT_COLOR.rgb * LIGHT_ENERGY, 1.0);
	}
	if (light_pos.y >= object_pos.y){
		LIGHT = vec4(0.,0.,0.,0.);
	}
}"

[resource]
shader = SubResource("Shader_byyf6")
shader_parameter/object_pos = Vector2(0, 0)
shader_parameter/light_pos = Vector2(0, 0)
